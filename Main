-- [ Royale High ]
local RoyaleWalkEnabled = false

SubCustom:CreateToggle({
    Name = "[Royale] Auto Walk Straight",
    Callback = function(Value)
        RoyaleWalkEnabled = Value
        if Value then
            Window:Log("[Royale] Auto Walk Active")
            task.spawn(function()
                -- Ditambahkan Window.IsAlive sesuai dokumentasi
                while RoyaleWalkEnabled and Window.IsAlive do
                    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * 2
                    end
                    task.wait(0.1)
                end
            end)
        else
            Window:Log("[Royale] Auto Walk Stopped")
        end
    end,
})

-- [ Grow a Garden 2 ]
SubCustom:CreateButton({
    Name = "[Garden 2] Swap to Halloween",
    Callback = function()
        pcall(function()
            local event = ReplicatedStorage.GameEvents.EasterEvent.LoadSpecialGardenRE
            if event then
                event:FireServer("HALLOWEEN_2026")
                Window:Log("[Garden 2] Swapped to Halloween")
            end
        end)
    end,
})

local AutoBuySpeed = false
SubCustom:CreateToggle({
    Name = "[Garden 2] Auto Buy Speed Halloween",
    Callback = function(Value)
        AutoBuySpeed = Value
        if Value then
            Window:Log("[Garden 2] Auto Buy Active")
            task.spawn(function()
                -- Ditambahkan Window.IsAlive sesuai dokumentasi
                while AutoBuySpeed and Window.IsAlive do
                    pcall(function()
                        local event = ReplicatedStorage.GameEvents.BuyEventShopStock
                        if event then
                            event:FireServer("Halloween Candy Corn Carrot", "Scary Seeds")
                        end
                    end)
                    task.wait(0.5)
                end
            end)
        else
            Window:Log("[Garden 2] Auto Buy Stopped")
        end
    end,
})

SubCustom:CreateButton({
    Name = "[Garden 2] Auto Sell Seed Halloween",
    Callback = function()
        pcall(function()
            local event = ReplicatedStorage.GameEvents.Events.Halloween2026Event.HalloweenSellInventoryRE
            if event then
                event:FireServer()
                Window:Log("[Garden 2] Seeds Sold")
            end
        end)
    end,
})

-- [ Carve Wood ]
SubCustom:CreateButton({
    Name = "[Carve] Execute Auto Accuracy 100%",
    Callback = function()
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/xuqor/Auto/refs/heads/main/Carve"))()
