-- ==================== CUSTOM HELPERS ====================

-- [ Guts and Black Powder ]
SubGuts:CreateButton({
    Name = "Execute Helper Script",
    Callback = function()
        pcall(function() loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/04adf4b7efffad41374a62e13396c97e.lua"))() end)
        Window:Log("[G&B] Script Executed")
    end,
})

-- [ Sleep Paralysis ]
SubSleep:CreateButton({
    Name = "Teleport to Refuse",
    Callback = function()
        local ok, part = pcall(function() return Workspace.Maze.Generators.CoreGenerator end)
        if ok and part then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                Window:Log("[Sleep] TP Success")
            end
        else
            Window:Log("[Sleep] CoreGenerator tidak ditemukan")
        end
    end,
})

SubSleep:CreateButton({
    Name = "Get Gasoline",
    Callback = function()
        local found = false
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name == "Item_payload" then
                local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.ActionText == "GAS CAN" then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = v.CFrame + Vector3.new(0, 5, 0)
                        task.wait(0.2)
                        if type(fireproximityprompt) == "function" then
                            prompt.HoldDuration = 0
                            pcall(fireproximityprompt, prompt)
                        end
                        found = true
                        Window:Log("[Sleep] Gasoline Collected")
                    end
                    break
                end
            end
        end
        if not found then Window:Log("[Sleep] Gasoline tidak ada di map") end
    end,
})

-- [ Prism Runaway ]
local PrismAntiAFK = false
local PrismAFKConnection
SubPrism:CreateToggle({
    Name = "Anti AFK",
    Callback = function(Value)
        PrismAntiAFK = Value
        if Value then
            PrismAFKConnection = LocalPlayer.Idled:Connect(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
            Window:Log("[Prism] Anti AFK Active")
        else
            if PrismAFKConnection then PrismAFKConnection:Disconnect() end
            Window:Log("[Prism] Anti AFK Disabled")
        end
    end,
})

