local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- Load Alaric UI Library
local AlaricLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/Alaricvoneltz/Alaricgui-/refs/heads/main/Main"))()

local Window = AlaricLibrary:CreateWindow({
    Name = "Alaric Hub",
    SubTitle = "The Hollow, UGC, & Badges"
})

-- ==================== TAB SYSTEM LOGS ====================
local TabLogs = Window:CreateTab({ Name = "Logs Console" })
local SubLogs = TabLogs:CreateSubTab({ Name = "System Logs" })

-- ==================== FUNGSI HELPER ====================
-- Pastikan fungsi CreateButton SUDAH ADA di dalam library GitHub-mu!
local function AddScriptEntry(TargetSubTab, Name, Url)
    TargetSubTab:CreateButton({
        Name = "Execute " .. Name,
        Callback = function()
            loadstring(game:HttpGet(Url))()
            Window:Log("Executed: " .. Name)
        end,
    })
end


-- =======================================================
-- ==================== TAB THE HOLLOW ====================
-- =======================================================
local TabHollow = Window:CreateTab({ Name = "The Hollow" })
-- Tetap menggunakan 1 Sub-Tab agar library-mu tidak error saat merender elemen
local SubHollowMain = TabHollow:CreateSubTab({ Name = "Floor Scripts" })

AddScriptEntry(SubHollowMain, "Floor 1", "https://paste-web.baconbossscript.workers.dev/raw/U3eRMC390A")
AddScriptEntry(SubHollowMain, "Floor 2", "https://paste-web.baconbossscript.workers.dev/raw/it5ijOv4wy")
AddScriptEntry(SubHollowMain, "Floor 3", "https://paste-web.baconbossscript.workers.dev/raw/y9C7ndcH7u")
AddScriptEntry(SubHollowMain, "Floor 4", "https://paste-web.baconbossscript.workers.dev/raw/HohiNT23xo")

-- Toggle Auto-Win ZombieBridge (Floor 4)
SubHollowMain:CreateToggle({
    Name = "Auto-Win ZombieBridge",
    Callback = function(Value)
        if Value then
            task.spawn(function()
                Window:Log("[Auto-Win] Memulai ZombieBridge...")
                local RemoteUtils
                pcall(function()
                    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
                        if obj:IsA("ModuleScript") and obj.Name == "RemoteUtils" then
                            RemoteUtils = require(obj)
                            break
                        end
                    end
                end)

                local function getRemoteFunction(name)
                    if RemoteUtils and RemoteUtils.GetRemoteFunction then
                        local success, rf = pcall(function()
                            return RemoteUtils.GetRemoteFunction(name)
                        end)
                        if success and rf then return rf end
                    end
                    return ReplicatedStorage:FindFirstChild(name, true)
                end

                local pathRemote = getRemoteFunction("ZombieBridgePath")
                local finishRemote = getRemoteFunction("ZombieBridgeFinish")

                if pathRemote then
                    local success, data = pcall(function()
                        return pathRemote:InvokeServer()
                    end)
                    
                    if success and data and data.Path then
                        local character = LocalPlayer.Character
                        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        
                        if rootPart then
                            Window:Log("[Auto-Win] Jalur ditemukan! Mulai teleport...")
                            
                            local tileFolder = workspace:FindFirstChild("ZombieBridgeProps") and workspace.ZombieBridgeProps:FindFirstChild("Tiles")
                            
                            if tileFolder then
                                for _, tileIndex in ipairs(data.Path) do
                                    local tilePart = tileFolder:FindFirstChild("Tile" .. tileIndex)
                                    if tilePart then
                                        character:PivotTo(tilePart.CFrame + Vector3.new(0, 3, 0))
                                        task.wait(0.15)
                                    end
                                end
                            end
                            
                            if finishRemote then
                                pcall(function()
                                    finishRemote:InvokeServer()
                                end)
                            end
                            Window:Log("[Auto-Win] Selesai!")
                        end
                    else
                        Window:Log("[Auto-Win] Gagal mengambil data Path dari server.")
                    end
                else
                    Window:Log("[Auto-Win] Remote 'ZombieBridgePath' tidak ditemukan.")
                end
            end)
        end
    end
})


