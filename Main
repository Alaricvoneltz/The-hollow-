        Window:Log("[Carve] Accuracy Script Executed")
    end,
})

local AutoKillBoss = false
SubCustom:CreateToggle({
    Name = "[Carve] Auto Attack Haunted Tree",
    Callback = function(Value)
        AutoKillBoss = Value
        if Value then
            Window:Log("[Carve] Auto Kill Boss Active")
            task.spawn(function()
                -- Ditambahkan Window.IsAlive sesuai dokumentasi
                while AutoKillBoss and Window.IsAlive do
                    pcall(function()
                        local boss = Workspace:FindFirstChild("HauntedTree")
                        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local remoteEvent = ReplicatedStorage:FindFirstChild("REM") and ReplicatedStorage.REM:FindFirstChild("268eb158-4db5-481b-8c94-c70c6dd43903")
                        
                        if boss and hrp then
                            hrp.CFrame = boss.CFrame + Vector3.new(0, 8, 0)
                            task.wait(0.2)
                            
                            if remoteEvent then
                                local args = {
                                    {
                                        Dir = Vector3.new(-0.0631895661354065, 0, -0.9980016350746155),
                                        Kind = "Swing",
                                        Pos = Vector3.new(-888.2090454101562, 34.14995574951172, -1397.34228515625),
                                        Combo = 3
                                    }
                                }
                                remoteEvent:FireServer(unpack(args))
                            end
                        end
                    end)
                    task.wait(0.4)
                end
            end)
        else
            Window:Log("[Carve] Auto Kill Boss Disabled")
        end
    end,
})
