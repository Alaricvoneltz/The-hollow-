local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local localPlayer = Players.LocalPlayer

-- Memuat Alaric UI Library
local AlaricLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/Alaricvoneltz/Alaricgui-/refs/heads/main/Main"))()

local Window = AlaricLibrary:CreateWindow({
    Name = "Alaric Hub",
    SubTitle = "The Hollow & Badges"
})

-- ==================== TAB SYSTEM LOGS ====================
-- Wajib dibuat agar fungsi Window:Log() berjalan tanpa error
local TabLogs = Window:CreateTab({ Name = "Logs Console" })
local SubLogs = TabLogs:CreateSubTab({ Name = "System Logs" })

-- ==================== TAB MAIN SCRIPTS ====================
local TabScripts = Window:CreateTab({ Name = "Main Scripts" })
local SubHollow = TabScripts:CreateSubTab({ Name = "The Hollow" })
local SubUGC = TabScripts:CreateSubTab({ Name = "UGC" })

-- ==================== TAB BADGES & CUSTOM ====================
local TabBadge = Window:CreateTab({ Name = "Badges & Events" })
local SubBadgeList = TabBadge:CreateSubTab({ Name = "Badge List" })
local SubCustom = TabBadge:CreateSubTab({ Name = "Custom Helpers" })

-- Fungsi helper yang disesuaikan untuk Alaric UI
local function AddScriptEntry(TargetSubTab, Name, Url)
    local scriptString = 'loadstring(game:HttpGet("' .. Url .. '"))()'
    
    -- Asumsi library-mu mendukung CreateButton dengan format standar
    TargetSubTab:CreateButton({
        Name = "Execute " .. Name,
        Callback = function()
            loadstring(game:HttpGet(Url))()
            Window:Log("Executed Script: " .. Name)
        end,
    })
    
    TargetSubTab:CreateButton({
        Name = "Copy " .. Name .. " Script",
        Callback = function()
            setclipboard(scriptString)
            Window:Log("Copied to clipboard: " .. Name)
        end,
    })
end

