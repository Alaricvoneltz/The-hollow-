local SubSleep = TabBadge:CreateSubTab({ Name = "Sleep Paralysis" })
SubSleep:CreateButton({
    Name = "Teleport to Refuse",
    Callback = function()
        local ok, part = pcall(function() return Workspace.Maze.Generators.CoreGenerator end)
        if ok and part and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
            localPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 5, 0)
            Window:Log("[Sleep] TP Success")
        end
    end,
})
SubSleep:CreateButton({
    Name = "Get Gasoline",
    Callback = function()
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name == "Item_payload" then
                local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.ActionText == "GAS CAN" and localPlayer.Character then
                    localPlayer.Character.HumanoidRootPart.CFrame = v.CFrame + Vector3.new(0, 5, 0)
                    task.wait(0.2)
                    if type(fireproximityprompt) == "function" then
                        prompt.HoldDuration = 0
                        pcall(fireproximityprompt, prompt)
                    end
                    Window:Log("[Sleep] Gasoline Collected")
                    return
                end
            end
        end
    end,
})

local SubPrism = TabBadge:CreateSubTab({ Name = "Prism Runaway" })
local PrismAFKConnection
SubPrism:CreateToggle({
    Name = "Anti AFK",
    Callback = function(Value)
        if Value then
            PrismAFKConnection = localPlayer.Idled:Connect(function() VirtualUser:ClickButton2(Vector2.new()) end)
            Window:Log("[Prism] Anti AFK Active")
        elseif PrismAFKConnection then
            PrismAFKConnection:Disconnect()
            Window:Log("[Prism] Anti AFK Disabled")
        end
    end,
})

