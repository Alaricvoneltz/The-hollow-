}

local FloorOptions = {"Floor 1", "Floor 2", "Floor 3", "Floor 4", "Floor 5", "Floor 6", "Floor 7", "Floor 8"}

-- Dropdown Execute Script
SubHollowMain:CreateDropdown({
    Name = "Execute Floor Script",
    Options = FloorOptions,
    Callback = function(SelectedFloor)
        local url = FloorScripts[SelectedFloor]
        if url then
            loadstring(game:HttpGet(url))()
            Window:Log("Executed: " .. SelectedFloor)
        end
    end
})

-- Dropdown Copy Script
SubHollowMain:CreateDropdown({
    Name = "Copy Floor Script",
    Options = FloorOptions,
    Callback = function(SelectedFloor)
        local url = FloorScripts[SelectedFloor]
        if url then
            setclipboard('loadstring(game:HttpGet("' .. url .. '"))()')
            Window:Log("Copied: " .. SelectedFloor)
        end
    end
})

-- Sub-Tab More (Auto-Win Zombie Bridge)
SubHollowMore:CreateButton({
    Name = "instan Quest floor 4",
    Callback = function()
        local RemoteUtils
        pcall(function()
            for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
                if obj:IsA("ModuleScript") and obj.Name == "RemoteUtils" then
                    RemoteUtils = require(obj)
                    break
                end
            end
        end)

        local function getRemoteFunction(name)
            if RemoteUtils and RemoteUtils.GetRemoteFunction then
                local suc, rf = pcall(function() return RemoteUtils.GetRemoteFunction(name) end)
                if suc and rf then return rf end
            end
            return ReplicatedStorage:FindFirstChild(name, true)
        end

        local pathRemote = getRemoteFunction("ZombieBridgePath")
        local finishRemote = getRemoteFunction("ZombieBridgeFinish")

        if pathRemote then
            local suc, data = pcall(function() return pathRemote:InvokeServer() end)
            if suc and data and data.Path then
                local character = localPlayer.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    Window:Log("[Auto-Win] Jalur ditemukan! Teleportasi...")
                    local tileFolder = Workspace:FindFirstChild("ZombieBridgeProps") and Workspace.ZombieBridgeProps:FindFirstChild("Tiles")
                    if tileFolder then
                        for _, tileIndex in ipairs(data.Path) do
                            local tilePart = tileFolder:FindFirstChild("Tile" .. tileIndex)
                            if tilePart then
                                character:PivotTo(tilePart.CFrame + Vector3.new(0, 3, 0))
                                task.wait(0.15)
                            end
                        end
                    end
                    if finishRemote then pcall(function() finishRemote:InvokeServer() end) end
                    Window:Log("[Auto-Win] Selesai!")
                end
            else
                Window:Log("[Auto-Win] Gagal mengambil Path!")
            end
        else
            Window:Log("[Auto-Win] Remote tidak ditemukan.")
        end
    end
})

