local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local localPlayer = Players.LocalPlayer

-- Memuat Alaric UI Library
local AlaricLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/Alaricvoneltz/Alaricgui-/refs/heads/main/Main"))()

local Window = AlaricLibrary:CreateWindow({
    Name = "Alaric Hub",
    SubTitle = "The Hollow"
})

-- ==================== TAB SYSTEM LOGS ====================
local TabLogs = Window:CreateTab({ Name = "Logs Console" })
local SubLogs = TabLogs:CreateSubTab({ Name = "System Logs" })

-- ==================== FUNGSI HELPER ====================
local function AddScriptEntry(TargetSubTab, Name, Url)
    local scriptString = 'loadstring(game:HttpGet("' .. Url .. '"))()'
    TargetSubTab:CreateButton({
        Name = "Execute " .. Name,
        Callback = function()
            loadstring(game:HttpGet(Url))()
            Window:Log("Executed: " .. Name)
        end,
    })
    TargetSubTab:CreateButton({
        Name = "Copy " .. Name .. " Script",
        Callback = function()
            setclipboard(scriptString)
            Window:Log("Copied: " .. Name)
        end,
    })
end

