-- [ Royale High ]
local RoyaleWalkEnabled = false
SubRoyale:CreateToggle({
    Name = "Auto Walk Straight",
    Callback = function(Value)
        RoyaleWalkEnabled = Value
        if Value then
            Window:Log("[Royale] Auto Walk Active")
            task.spawn(function()
                while RoyaleWalkEnabled and Window.IsAlive do
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * 2 end
                    task.wait(0.1)
                end
            end)
        else
            Window:Log("[Royale] Auto Walk Stopped")
        end
    end,
})

-- [ Grow a Garden 2 ]
SubGarden:CreateButton({
    Name = "Swap to Halloween",
    Callback = function()
        pcall(function()
            local event = ReplicatedStorage.GameEvents.EasterEvent.LoadSpecialGardenRE
            if event then
                event:FireServer("HALLOWEEN_2026")
                Window:Log("[Garden 2] Swapped")
            end
        end)
    end,
})

local AutoBuySpeed = false
SubGarden:CreateToggle({
    Name = "Auto Buy Speed Halloween",
    Callback = function(Value)
        AutoBuySpeed = Value
        if Value then
            Window:Log("[Garden 2] Auto Buy Active")
            task.spawn(function()
                while AutoBuySpeed and Window.IsAlive do
                    pcall(function()
                        local event = ReplicatedStorage.GameEvents.BuyEventShopStock
                        if event then event:FireServer("Halloween Candy Corn Carrot", "Scary Seeds") end
                    end)
                    task.wait(0.5)
                end
            end)
        else
            Window:Log("[Garden 2] Auto Buy Stopped")
        end
    end,
})

SubGarden:CreateButton({
    Name = "Auto Sell Seed Halloween",
    Callback = function()
        pcall(function()
            local event = ReplicatedStorage.GameEvents.Events.Halloween2026Event.HalloweenSellInventoryRE
            if event then
                event:FireServer()
                Window:Log("[Garden 2] Seeds Sold")
            end
        end)
    end,
})

-- [ Carve Wood ]
SubCarve:CreateButton({
    Name = "Execute Auto Accuracy 100%",
    Callback = function()
        pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/xuqor/Auto/refs/heads/main/Carve"))() end)
        Window:Log("[Carve] Accuracy Script Executed")
    end,
})

local AutoKillBoss = false
SubCarve:CreateToggle({
    Name = "Auto Attack Haunted Tree",
    Callback = function(Value)
        AutoKillBoss = Value
        if Value then
            Window:Log("[Carve] Auto Kill Boss Active")
            task.spawn(function()
                while AutoKillBoss and Window.IsAlive do
                    pcall(function()
                        local boss = Workspace:FindFirstChild("HauntedTree")
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local remoteEvent = ReplicatedStorage:FindFirstChild("REM") and ReplicatedStorage.REM:FindFirstChild("268eb158-4db5-481b-8c94-c70c6dd43903")
                        
                        if boss and hrp then
                            hrp.CFrame = boss.CFrame + Vector3.new(0, 8, 0)
                            task.wait(0.2)
                            if remoteEvent then
                                local args = {
                                    {
                                        Dir = Vector3.new(-0.0631895661354065, 0, -0.9980016350746155),
                                        Kind = "Swing",
                                        Pos = Vector3.new(-888.2090454101562, 34.14995574951172, -1397.34228515625),
                                        Combo = 3
                                    }
                                }
                                remoteEvent:FireServer(unpack(args))
                            end
                        end
                    end)
                    task.wait(0.4)
                end
            end)
        else
            Window:Log("[Carve] Auto Kill Boss Disabled")
        end
    end,
})
