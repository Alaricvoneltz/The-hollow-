local SubCarve = TabBadge:CreateSubTab({ Name = "Carve Wood" })
SubCarve:CreateButton({
    Name = "Execute Auto Accuracy",
    Callback = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/xuqor/Auto/refs/heads/main/Carve"))() end) end,
})
local CarveAutoKill = false
SubCarve:CreateToggle({
    Name = "Auto Attack Haunted Tree",
    Callback = function(Value)
        CarveAutoKill = Value
        if Value then
            task.spawn(function()
                while CarveAutoKill and Window.IsAlive do
                    pcall(function()
                        local boss = Workspace:FindFirstChild("HauntedTree")
                        local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if boss and hrp then
                            hrp.CFrame = boss.CFrame + Vector3.new(0, 8, 0)
                            task.wait(0.2)
                            local remoteEvent = ReplicatedStorage:FindFirstChild("REM") and ReplicatedStorage.REM:FindFirstChild("268eb158-4db5-481b-8c94-c70c6dd43903")
                            if remoteEvent then
                                remoteEvent:FireServer({Dir = Vector3.new(-0.063, 0, -0.998), Kind = "Swing", Pos = Vector3.new(-888, 34, -1397), Combo = 3})
                            end
                        end
                    end)
                    task.wait(0.4)
                end
            end)
        end
    end,
})
