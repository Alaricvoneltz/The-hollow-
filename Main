-- ==================== CUSTOM HELPERS SECTION ====================

-- [ Guts and Black Powder ]
SubCustom:CreateButton({
    Name = "[G&B] Execute Helper Script",
    Callback = function()
        pcall(function()
            loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/04adf4b7efffad41374a62e13396c97e.lua"))()
        end)
        Window:Log("[G&B] Helper Script Executed")
    end,
})

-- [ Sleep Paralysis ]
SubCustom:CreateButton({
    Name = "[Sleep] Teleport to Refuse",
    Callback = function()
        local ok, part = pcall(function()
            return Workspace.Maze.Generators.CoreGenerator
        end)
        if ok and part then
            local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
                Window:Log("[Sleep] TP to Refuse Success")
            end
        else
            Window:Log("[Sleep] CoreGenerator nggak ketemu")
        end
    end,
})

SubCustom:CreateButton({
    Name = "[Sleep] Get Gasoline",
    Callback = function()
        local found = false
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name == "Item_payload" then
                local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.ActionText == "GAS CAN" then
                    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = v.CFrame + Vector3.new(0, 5, 0)
                        task.wait(0.2)
                        if type(fireproximityprompt) == "function" then
                            prompt.HoldDuration = 0
                            pcall(fireproximityprompt, prompt)
                        end
                        found = true
                        Window:Log("[Sleep] Gasoline Collected")
                    end
                    break
                end
            end
        end
        if not found then
            Window:Log("[Sleep] Gasoline nggak ketemu di map")
        end
    end,
})

-- [ Prism Runaway ]
local PrismAntiAFK = false
local PrismAFKConnection

SubCustom:CreateToggle({
    Name = "[Prism] Anti AFK",
    Callback = function(Value)
        PrismAntiAFK = Value
        if Value then
            Window:Log("[Prism] Anti AFK Active")
            PrismAFKConnection = localPlayer.Idled:Connect(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        else
            Window:Log("[Prism] Anti AFK Disabled")
            if PrismAFKConnection then PrismAFKConnection:Disconnect() end
        end
    end,
})

-- [ Clean Leaves ]
